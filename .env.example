# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=sessions_marketplace
POSTGRES_USER=sessions
POSTGRES_PASSWORD=change-me-local-dev
# Host/port are how the *backend* reaches Postgres inside the compose network.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Django -------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret
# 1 for local evaluation (enables the dev-login endpoint used when you have no
# Google OAuth client id). Set to 0 for anything deployed / shared.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# ---- JWT (backend-issued access/refresh tokens) --------------------------
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Google OAuth -------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application). The backend verifies Google ID tokens against this client id.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---- Frontend (build-time, injected by Vite) ---------------------------
# Same Google client id as above; used to render the Google Sign-In button.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Where the SPA sends API calls. Behind nginx this is a relative path.
VITE_API_BASE_URL=/api
